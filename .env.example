# plantilla del .env, se copia como .env y se llenan los valores, el .env real nunca se sube a git.
# los scripts de persistencia cargan este archivo antes de arrancar porque go no lo lee solo.

# cadena de la base principal en supabase, sale de connect y session pooler
DATABASE_URL='postgresql://postgres.TU_REF:TU_PASSWORD@TU_HOST.pooler.supabase.com:5432/postgres?sslmode=require'
# escalabilidad de lectura, cadena opcional de una replica para las consultas de eventos
# DATABASE_URL_LECTURA='postgresql://postgres.TU_REF:TU_PASSWORD@TU_HOST_REPLICA.pooler.supabase.com:5432/postgres?sslmode=require'
# base de pruebas para go test, sus datos se borran, nunca poner aqui la de supabase
SRB_TEST_DATABASE_URL='postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable'
